# @plugin(@varlock/proton-pass-plugin)
#
# @initProtonPass()
#
# @defaultSensitive=false
# ---

# @type=string @required
DATABASE_URL=data/coursebooker.db

# @sensitive @required
NUXT_AUTH_SECRET=

# @required
AZURE_AD_TENANT_ID=protonPass("pass://DCC-KI/COURSEBOOKER/AZURE_AD_TENANT_ID")

# @required
AZURE_AD_CLIENT_ID=protonPass("pass://DCC-KI/COURSEBOOKER/AZURE_AD_CLIENT_ID")

# @sensitive @required
AZURE_AD_CLIENT_SECRET=protonPass("pass://DCC-KI/COURSEBOOKER/AZURE_AD_CLIENT_SECRET")

# @type=url @optional
AUTH_ORIGIN=

# @optional
SMTP_HOST=localhost

# @type=port @optional
SMTP_PORT=1025

# @sensitive @optional
GITHUB_TOKEN=protonPass("pass://DCC-KI/FEEDBACK_DEV_GITHUB_TOKEN/TOKEN", allowMissing=true)

# @optional
DEFAULT_ADMIN=tobias.bollinger@bs.ch

# @type=url @optional
