# @import(./.env.pass.schema, enabled=eq($APP_MODE, dev))
# @defaultSensitive=false
# ---

# @type=enum(dev, build, ci, prod)
APP_MODE=dev

# @type=boolean
IS_RUNTIME=ifs(
    eq($APP_MODE, dev), true,
    eq($APP_MODE, prod), true,
    false
)

# @type=string @required
DATABASE_URL=data/coursebooker.db

# @sensitive @required=$IS_RUNTIME
NUXT_AUTH_SECRET=

# @required=$IS_RUNTIME
AZURE_AD_TENANT_ID=

# @required=$IS_RUNTIME
AZURE_AD_CLIENT_ID=

# @sensitive @required=$IS_RUNTIME
AZURE_AD_CLIENT_SECRET=

# @type=url @optional
AUTH_ORIGIN=

# @optional
SMTP_HOST=localhost

# @type=port @optional
SMTP_PORT=1030

# @sensitive @optional
GITHUB_TOKEN=

# @required
MAIL_FROM=

# @required
DEFAULT_ADMIN=

# @type=url @optional
NUXT_SITE_URL=http://localhost:3000

# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug
