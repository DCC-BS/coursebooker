# @import(./.env.pass.schema, enabled=eq($APP_MODE, dev))
# @import(./.env.azure.schema, enabled=eq($AUTH_MODE, "azure"))
# @defaultSensitive=false
# ---

# @type=string @required
DATABASE_URL=data/coursebooker.db

# @optional
SMTP_HOST=localhost

# @type=port @optional
SMTP_PORT=1030

# @required
NUXT_MAIL_FROM=

# @required
DEFAULT_ADMIN=

# @type=url @optional
NUXT_SITE_URL=http://localhost:3000

# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug

# Runtime override of runtimeConfig.public.logger.loglevel (defaults to LOG_LEVEL)
# @public @type=enum(trace, debug, info, warn, error, fatal)
NUXT_PUBLIC_LOGGER_LOGLEVEL=$LOG_LEVEL

# Service name in every log line (`app` field of the DCC-BS log contract)
# @optional @public @type=string
NUXT_PUBLIC_LOGGER_APP=coursebooker
